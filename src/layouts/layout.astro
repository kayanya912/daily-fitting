---
import '../styles/global.css';

interface Props { title?: string; }
const { title = 'daily fitting' } = Astro.props;
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport" />
    <meta content="mobile_tab" name="shell-type" />
    <meta name="theme-color" content="#fef8f3" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
  </head>

  <body class="bg-surface font-body-md text-on-surface flex flex-col min-h-screen">

    <!-- ============ NAVBAR (SOLID, TIDAK TRANSPARAN) ============ -->
    <header
      class="fixed top-0 left-0 right-0 w-full z-50 pt-safe"
      style="
        background-color: #fef8f3;
        border-bottom: 1px solid rgba(116, 89, 72, 0.10);
        box-shadow: 0 1px 2px rgba(67, 45, 30, 0.04);
        -webkit-backdrop-filter: blur(12px) saturate(1.2);
        backdrop-filter: blur(12px) saturate(1.2);
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        will-change: transform;
      "
    >
      <div class="container-x navbar-inner">
        <!-- Brand kecil -->
        <a
          href="/"
          style="
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            flex-shrink: 0;
          "
        >
          <span class="material-symbols-outlined text-secondary" style="font-size: 18px;">spa</span>
          <span
            class="font-headline-sm text-primary italic"
            style="
              font-size: 15px;
              line-height: 1;
              white-space: nowrap;
            "
          >
          </span>
        </a>

        <!-- Search bar -->
        <div class="nav-search">
          <span class="nav-search-icon">
            <span class="material-symbols-outlined" style="font-size: 18px;">search</span>
          </span>
          <input
            id="productSearchInput"
            type="text"
            autocomplete="off"
            placeholder="Cari produk..."
          />
          <button id="clearSearchBtn" class="nav-search-clear" aria-label="Bersihkan">
            <span class="material-symbols-outlined" style="font-size: 16px;">cancel</span>
          </button>
        </div>
      </div>
    </header>

    <!-- ============ MAIN ============ -->
    <main
      class="flex-1 flex flex-col relative w-full"
      style="
        background-color: #fef8f3;
        padding-top: calc(58px + env(safe-area-inset-top, 0px));
      "
    >
      <slot />
    </main>

    <!-- ============ TOAST ============ -->
    <div
      class="fixed z-50 pointer-events-none opacity-0 translate-y-4 transition-all duration-300"
      id="copyToast"
      style="bottom: 24px; left: 0; right: 0; display: flex; justify-content: center; padding-left: 24px; padding-right: 24px;"
    >
      <div
        class="text-surface"
        style="
          background-color: #432d1e;
          padding: 10px 16px;
          border-radius: 9999px;
          display: flex;
          align-items: center;
          gap: 8px;
          max-width: 100%;
          box-shadow: 0 4px 12px rgba(67, 45, 30, 0.15), 0 12px 32px rgba(67, 45, 30, 0.18);
        "
      >
        <span class="material-symbols-outlined" style="font-size: 16px; flex-shrink: 0; color: #d0e6c8;">check_circle</span>
        <span style="font-size: 12px; white-space: nowrap;">Link berhasil disalin!</span>
      </div>
    </div>

  </body>
</html>